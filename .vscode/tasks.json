{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build scene",
            "type": "shell",
            "command": "/usr/bin/g++",
            "args": [
                "-g",
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "main.cpp",
                "-o",
                "phm-scene",
                "-lglut",
                "-lGL",
                "-lGLU",
                "-lGLEW"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Run scene",
            "type": "shell",
            "command": "./phm-scene",
            "args": [],
            "dependsOn": "Build scene",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
