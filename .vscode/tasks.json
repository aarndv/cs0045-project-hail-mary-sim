{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build scene",
            "type": "shell",
            "command": "/usr/bin/g++",
            "args": [
                "-g",
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "main.cpp",
                "-o",
                "phm-scene",
                "-lglut",
                "-lGL",
                "-lGLU",
                "-lGLEW"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "windows": {
                "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
                "args": [
                    "-g",
                    "-std=c++17",
                    "-Wall",
                    "-Wextra",
                    "main.cpp",
                    "-o",
                    "phm-scene.exe",
                    "-lfreeglut",
                    "-lopengl32",
                    "-lglu32",
                    "-lglew32"
                ]
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Run scene",
            "type": "shell",
            "command": "./phm-scene",
            "args": [],
            "dependsOn": "Build scene",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "windows": {
                "command": ".\\phm-scene.exe",
                "options": {
                    "cwd": "${workspaceFolder}",
                    "env": {
                        "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
                    }
                }
            },
            "problemMatcher": []
        }
    ]
}
