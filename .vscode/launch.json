{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Build and Debug Scene",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/phm-scene",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "windows": {
                "program": "${workspaceFolder}\\phm-scene.exe",
                "miDebuggerPath": "C:\\msys64\\ucrt64\\bin\\gdb.exe",
                "environment": [
                    {
                        "name": "PATH",
                        "value": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
                    }
                ]
            },
            "setupCommands": [
                {
                    "description": "Enable GDB pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build scene"
        }
    ]
}
